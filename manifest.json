{
  "manifest_version": 3,
  "name": "Thống kê bài đăng Facebook",
  "version": "1.0.0",
  "description": "Đếm bài trên trang cá nhân và trong nhóm theo tháng từ Nhật ký hoạt động.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*/allactivity*"
      ],
      "js": [
        "report.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/48.png"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
